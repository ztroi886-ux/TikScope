# Copy this file to .env for local runs. NEVER commit the real .env.
# On Railway these go in the service's Variables tab instead.

# From @BotFather. Required for the Telegram bot; the website runs without it.
TELEGRAM_BOT_TOKEN=paste_your_token_here

# Telegram user IDs allowed to use the bot. Comma-separated for several.
# Get yours by messaging @userinfobot.
ADMIN_IDS=7621546358

# Secure web dashboard at /admin. Omit the password to keep it disabled.
ADMIN_DASHBOARD_PASSWORD=replace_with_a_long_unique_password
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret

# Where the bot writes client files, vacancies, applications and photos.
# Leave unset locally. On Railway set it to your mounted volume path so the
# data survives redeploys, e.g. /data
# DATA_DIR=/data

# Set automatically by Railway. Only needed locally if 10000 is taken.
# PORT=10000
# PostgreSQL connection string. Supabase: Project Settings -> Database -> Connection string.
# Use the transaction pooler URL for hosted/serverless deployments.
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require
